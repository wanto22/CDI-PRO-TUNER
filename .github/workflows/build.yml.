name: NTECH PRO AUTO GENERATOR
on:
  push:
    branches: [ main ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v3

      - name: Setup Environment
        uses: actions/setup-node@v3
        with:
          node-version: '18'

      - name: Install Cordova
        run: npm install -g cordova

      - name: Generate Project Files
        run: |
          # 1. Buat proyek Cordova
          cordova create ntech_app com.ntech.pro "NTECH_Pro"
          cd ntech_app
          cordova platform add android@11.0.0
          cordova plugin add cordova-plugin-bluetooth-serial
          
          # 2. Tulis file config.xml secara otomatis
          cat <<EOF > config.xml
          <?xml version='1.0' encoding='utf-8'?>
          <widget id="com.ntech.pro" version="1.1.0" xmlns="http://www.w3.org/ns/widgets">
              <name>NTECH Pro Tuner</name>
              <content src="index.html" />
              <access origin="*" />
              <preference name="android-minSdkVersion" value="24" />
              <plugin name="cordova-plugin-bluetooth-serial" spec="~0.4.7" />
          </widget>
          EOF

          # 3. Tulis file index.html secara otomatis
          cat <<EOF > www/index.html
          <!DOCTYPE html>
          <html>
          <head>
              <meta charset="utf-8">
              <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no">
              <style>
                  :root { --bg: #0d0d0d; --card: #1a1a1a; --accent: #00ff88; --warn: #ffcc00; --text: #f0f0f0; }
                  body { font-family: sans-serif; background: var(--bg); color: var(--text); margin: 0; padding-bottom: 80px; }
                  .navbar { display: flex; justify-content: space-around; background: var(--card); position: fixed; bottom: 0; width: 100%; border-top: 1px solid #333; height: 70px; z-index: 1000; }
                  .nav-item { padding: 10px; color: #666; font-size: 11px; text-align: center; flex: 1; display: flex; flex-direction: column; justify-content: center; font-weight: bold;}
                  .nav-item.active { color: var(--accent); border-top: 3px solid var(--accent); background: #222; }
                  .tab-content { display: none; padding: 15px; }
                  .tab-content.active { display: block; }
                  .card { background: var(--card); padding: 15px; border-radius: 12px; margin-bottom: 12px; border: 1px solid #262626; }
                  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
                  .big-val { font-size: 32px; font-weight: bold; color: var(--accent); }
                  .label { font-size: 10px; color: #888; text-transform: uppercase; }
                  .table-scroll { height: 350px; overflow-y: auto; border: 1px solid #333; }
                  table { width: 100%; border-collapse: collapse; }
                  th, td { border: 1px solid #222; padding: 8px; text-align: center; }
                  input { width: 80%; background: #222; border: 1px solid #444; color: #fff; padding: 5px; border-radius: 4px; text-align: center;}
                  button { background: #2979ff; color: white; border: none; padding: 15px; border-radius: 10px; width: 100%; font-weight: bold; margin-top: 5px; }
                  .btn-save { background: var(--accent); color: #000; }
                  .btn-fetch { background: var(--warn); color: #000; margin-bottom: 10px; }
                  select { width: 100%; padding: 12px; background: #222; color: white; border-radius: 10px; margin-bottom: 10px; }
              </style>
          </head>
          <body>
              <div id="tab-monitor" class="tab-content active">
                  <h3 style="text-align:center">MONITORING</h3>
                  <div class="card"><button id="btnConn" onclick="connectBT()">HUBUNGKAN BLUETOOTH</button></div>
                  <div class="grid">
                      <div class="card"><div class="label">RPM</div><div id="valRPM" class="big-val">0</div></div>
                      <div class="card"><div class="label">Advance</div><div id="valAdv" class="big-val">0°</div></div>
                      <div class="card"><div class="label">Edge</div><div id="valEdge" class="big-val" style="font-size:20px">-</div></div>
                      <div class="card"><div class="label">Rumble</div><div id="valRumble" class="big-val" style="font-size:20px">OFF</div></div>
                  </div>
              </div>

              <div id="tab-kurva" class="tab-content">
                  <h3>EDITOR MAP</h3>
                  <button class="btn-fetch" onclick="fetchData()">TARIK DATA CDI</button>
                  <select id="mapSelector" onchange="renderMapTable()">
                      <option value="1">MAP 1</option>
                      <option value="2">MAP 2</option>
                      <option value="3">MAP 3</option>
                  </select>
                  <div class="table-scroll">
                      <table>
                          <thead><tr><th>#</th><th>RPM</th><th>Adv</th></tr></thead>
                          <tbody id="mapTableBody"></tbody>
                      </table>
                  </div>
                  <button class="btn-save" onclick="saveAllMaps()">SIMPAN SEMUA MAP</button>
              </div>

              <div id="tab-setting" class="tab-content">
                  <h3>SETTINGS</h3>
                  <div class="card">
                      <div class="grid">
                          <div><label class="label">Limiter</label><input type="number" id="setLim"></div>
                          <div><label class="label">Angle</label><input type="number" id="setAng"></div>
                          <div><label class="label">SCR Pulse</label><input type="number" id="setSCR"></div>
                          <div><label class="label">Edge (0/1)</label><input type="number" id="setEdge"></div>
                      </div>
                  </div>
                  <div class="card">
                      <label class="label">Rumble Start RPM</label>
                      <input type="number" id="setRblRPM" style="width:90%">
                      <label class="label">Rumble Skip</label>
                      <input type="number" id="setRblSkip" style="width:90%">
                  </div>
                  <button class="btn-save" onclick="saveSettings()">SIMPAN SYSTEM</button>
              </div>

              <div class="navbar">
                  <div class="nav-item active" onclick="openTab(event, 'tab-monitor')">MONITOR</div>
                  <div class="nav-item" onclick="openTab(event, 'tab-kurva')">KURVA</div>
                  <div class="nav-item" onclick="openTab(event, 'tab-setting')">SETTING</div>
              </div>

              <script src="cordova.js"></script>
              <script>
                  let maps = { 1: Array(32).fill(0), 2: Array(32).fill(0), 3: Array(32).fill(0) };
                  function openTab(e, n) {
                      document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
                      document.querySelectorAll('.nav-item').forEach(i => i.classList.remove('active'));
                      document.getElementById(n).classList.add('active');
                      e.currentTarget.classList.add('active');
                  }
                  function connectBT() {
                      bluetoothSerial.list(ds => {
                          let h = ds.find(d => d.name.includes("HC-05") || d.name.includes("BT"));
                          if(h) bluetoothSerial.connect(h.address, () => {
                              document.getElementById('btnConn').innerText = "CONNECTED ✅";
                              bluetoothSerial.subscribe('\n', d => parse(d.trim()));
                          }, () => alert("Gagal!"));
                      });
                  }
                  function parse(d) {
                      if(d.startsWith("RPM:")) document.getElementById('valRPM').innerText = d.split(":")[1];
                      if(d.startsWith("LIM:")) document.getElementById('setLim').value = d.split(":")[1];
                      if(d.startsWith("ANG:")) document.getElementById('setAng').value = d.split(":")[1];
                      if(d.startsWith("EDG:")) document.getElementById('setEdge').value = d.split(":")[1];
                      if(d.startsWith("RBL:")) document.getElementById('setRblRPM').value = d.split(":")[1];
                      if(d.startsWith("RSK:")) document.getElementById('setRblSkip').value = d.split(":")[1];
                      if(d.startsWith("M1:")) { maps[1] = d.substring(3).split(','); renderMapTable(); }
                      if(d.startsWith("M2:")) maps[2] = d.substring(3).split(',');
                      if(d.startsWith("M3:")) maps[3] = d.substring(3).split(',');
                  }
                  function renderMapTable() {
                      let id = document.getElementById('mapSelector').value;
                      let h = "";
                      for(let i=0; i<32; i++) {
                          h += "<tr><td>"+(i+1)+"</td><td>"+(i*500+500)+"</td><td><input type='number' value='"+maps[id][i]+"' onchange='maps["+id+"]["+i+"]=this.value'></td></tr>";
                      }
                      document.getElementById('mapTableBody').innerHTML = h;
                  }
                  function fetchData() { bluetoothSerial.write("GET\n"); }
                  function saveAllMaps() {
                      bluetoothSerial.write("M1:" + maps[1].join(',') + "\n");
                      setTimeout(() => bluetoothSerial.write("M2:" + maps[2].join(',') + "\n"), 600);
                      setTimeout(() => bluetoothSerial.write("M3:" + maps[3].join(',') + "\n"), 1200);
                      setTimeout(() => { bluetoothSerial.write("SAVE\n"); alert("Saved!"); }, 1800);
                  }
                  function saveSettings() {
                      let c = ["LIM:"+document.getElementById('setLim').value, "ANG:"+document.getElementById('setAng').value, "EDG:"+document.getElementById('setEdge').value, "RBL:"+document.getElementById('setRblRPM').value, "RSK:"+document.getElementById('setRblSkip').value, "SAVE"];
                      let i = 0;
                      let t = setInterval(() => { bluetoothSerial.write(c[i]+"\n"); i++; if(i>=c.length) clearInterval(t); }, 300);
                  }
              </script>
          </body>
          </html>
          EOF

      - name: Build APK
        run: |
          cd ntech_app
          # Menyiapkan SDK Android secara implisit melalui Cordova build
          cordova build android --debug

      - name: Upload APK
        uses: actions/upload-artifact@v3
        with:
          name: NTECH-CDI-PRO-APK
          path: ntech_app/platforms/android/app/build/outputs/apk/debug/app-debug.apk
