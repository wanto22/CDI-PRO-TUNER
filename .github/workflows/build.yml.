name: NTECH CDI BUILDER

on:
  push:
    branches: [ main ]
  workflow_dispatch:

jobs:
  build-android:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Source
        uses: actions/checkout@v3

      - name: Set Up Java JDK 11
        uses: actions/setup-java@v3
        with:
          distribution: 'temurin'
          java-version: '11'

      - name: Set Up Node.js
        uses: actions/setup-node@v3
        with:
          node-version: '18'

      - name: Install Cordova Compiler
        run: npm install -g cordova

      - name: Build Preparation
        run: |
          cordova create build_box com.ntech.cdipro "NTECH_Pro"
          cd build_box
          cordova platform add android@11.0.0
          cordova plugin add cordova-plugin-bluetooth-serial
          rm -rf www/*
          # Copy file index.html ke folder build
          cp ../www/index.html www/ || cp ../index.html www/
          # Copy config.xml ke folder build
          cp ../config.xml .

      - name: Build APK (Debug Mode)
        run: |
          cd build_box
          cordova build android --debug

      - name: Archive APK Result
        uses: actions/upload-artifact@v3
        with:
          name: NTECH-CDI-v5.7F-PRO
          path: build_box/platforms/android/app/build/outputs/apk/debug/app-debug.apk
